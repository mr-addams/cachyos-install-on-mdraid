# Сценарий unattended-установки — пример.
# Использование:
#   cp scenario.example.env stand.env
#   # заполнить пароли, диски, hostname; CONFIRM_DESTROY поставить yes
#   chmod 600 stand.env
#   scp stand.env liveiso:/tmp/stand.env
#   ssh liveiso 'curl -fsSL <url>/boot.sh | sudo bash -s -- --unattended --scenario /tmp/stand.env'
#
# Формат — env-файл KEY=VALUE. Значения со спецсимволами (пароли) — в одинарных
# кавычках. После установки файл затирается shred (в chroot и снаружи).

# Диски (имена без /dev). ВНИМАНИЕ: будут полностью зачищены.
DISK1=sda
DISK2=sdb

# Размеры разделов
ESP_SIZE=1GiB
BOOT_SIZE=1GiB
ROOT_SIZE=

# Метки ФС.
# ext4 (root/boot): [A-Za-z0-9_-], длина 1-16.
# ESP (FAT32): [A-Za-z0-9_-], длина 1-11.
ROOT_LABEL=cachy_root
BOOT_LABEL=cachy_boot
ESP_LABEL1=EFI-0
ESP_LABEL2=EFI-1

# Система и пользователь
HOSTNAME=p510-test
USERNAME=addams
USER_PASSWORD='заполнить'
ROOT_PASSWORD='заполнить'
# Shell пользователя в таргете: /bin/bash, /bin/zsh, /usr/bin/fish.
# Пакет shell должен быть в системе (zsh тянет cachyos-zsh-config из EXTRA_PKGS).
USER_SHELL=/bin/bash

# Локаль
LOCALE=en_US.UTF-8
KEYMAP=us
TIMEZONE=UTC

# Пакет ядра (если archinstall на ISO его не знает — скрипт временно ставит
# ванильный linux, а Фаза C меняет на запрошенное)
KERNEL_PKG=linux-cachyos
# Доп. пакеты к ядру (headers, LTS-ядро, драйвер): ставятся фазой C вместе
# со swap ядра — там уже есть репа cachyos. NB: nvidia-модуль обязан быть
# здесь, а не в EXTRA_PKGS: он зависит от linux-cachyos=X.Y-Z, которого
# в фазе B ещё нет.
KERNEL_EXTRA_PKGS="linux-cachyos-headers linux-cachyos-lts linux-cachyos-lts-headers"

# Доп. пакеты через пробел (добавятся к базовому набору silent-конфига).
# Состав ниже = стандартная Calamares-установка CachyOS + KDE
# (источник: /etc/calamares/modules/netinstall.yaml с ISO).
EXTRA_PKGS="cachyos-hooks cachyos-keyring cachyos-mirrorlist cachyos-v3-mirrorlist cachyos-v4-mirrorlist cachyos-rate-mirrors chwd cachyos-hello cachyos-kernel-manager cachyos-packageinstaller cachyos-settings cachyos-micro-settings cachyos-wallpapers cachyos-fish-config cachyos-zsh-config dnsmasq dnsutils ethtool iwd modemmanager networkmanager-openvpn nss-mdns usb_modeswitch wpa_supplicant wireless-regdb xl2tpd ufw ufw-extras bluez bluez-hid2hci bluez-libs bluez-utils bluez-obex pacman-contrib pkgfile rebuild-detector reflector shelly accountsservice bash-completion ffmpegthumbnailer gst-libav gst-plugin-pipewire gst-plugins-bad gst-plugins-ugly libdvdcss libgsf libopenraw plocate poppler-glib vlc-plugins-all xdg-user-dirs xdg-utils efitools nfs-utils nilfs-utils smartmontools unrar unzip awesome-terminal-fonts noto-fonts-emoji cantarell-fonts noto-fonts ttf-bitstream-vera ttf-dejavu ttf-liberation ttf-opensans ttf-meslo-nerd noto-fonts-cjk alsa-firmware alsa-plugins alsa-utils pavucontrol pipewire-pulse wireplumber pipewire-alsa realtime-privileges dmidecode dmraid hdparm hwdetect linux-firmware lsscsi mesa-utils mtools sg3_utils sof-firmware cpupower power-profiles-daemon upower alacritty btop duf fsarchiver git glances hwinfo meld nano-syntax-highlighting fastfetch pv python-defusedxml python-packaging wget ripgrep micro nano openssh ark bluedevil breeze-gtk cachy-update cachyos-emerald-kde-theme-git cachyos-iridescent-kde cachyos-kde-settings cachyos-nord-kde-theme-git char-white dolphin ffmpegthumbs filelight fwupd gwenview haruna kate kcalc kde-gtk-config kdeconnect kdegraphics-thumbnailers kdeplasma-addons kdialog kinfocenter kio-admin konsole kscreen kwallet-pam kwalletmanager partitionmanager phonon-qt6-vlc plasma-browser-integration plasma-desktop plasma-firewall plasma-nm plasma-pa plasma-systemmonitor plasma-thunderbolt plymouth-kcm powerdevil plasma-login-manager spectacle tesseract-data-eng xsettingsd firefox"

# Подтверждение сноса дисков. Без yes скрипт откажется работать.
CONFIRM_DESTROY=no
