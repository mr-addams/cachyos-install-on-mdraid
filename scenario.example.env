# Сценарий unattended-установки — пример.
# Использование:
#   cp scenario.example.env stand.env
#   # заполнить пароли, диски, hostname; CONFIRM_DESTROY поставить yes
#   chmod 600 stand.env
#   scp stand.env liveiso:/tmp/stand.env
#   ssh liveiso 'curl -fsSL <url>/boot.sh | sudo bash -s -- --unattended --scenario /tmp/stand.env'
#
# Формат — env-файл KEY=VALUE. Значения со спецсимволами (пароли) — в одинарных
# кавычках. После установки файл затирается shred (в chroot и снаружи).

# Диски (имена без /dev). ВНИМАНИЕ: будут полностью зачищены.
DISK1=sda
DISK2=sdb

# Размеры разделов
ESP_SIZE=512MiB
BOOT_SIZE=1GiB
ROOT_SIZE=

# Метки ФС (ext4-лимит: [A-Za-z0-9_-], длина 1-16)
ROOT_LABEL=cachy_root
BOOT_LABEL=cachy_boot

# Система и пользователь
HOSTNAME=p510-test
USERNAME=kate
USER_PASSWORD='заполнить'
ROOT_PASSWORD='заполнить'

# Локаль
LOCALE=en_US.UTF-8
KEYMAP=us
TIMEZONE=UTC

# Пакет ядра (если archinstall на ISO его не знает — скрипт временно ставит
# ванильный linux, а Фаза C меняет на запрошенное)
KERNEL_PKG=linux-cachyos

# Доп. пакеты через пробел (добавятся к базовому набору silent-конфига)
EXTRA_PKGS=

# Подтверждение сноса дисков. Без yes скрипт откажется работать.
CONFIRM_DESTROY=no
